<!-- Debug builds only: test hooks used by the CI emulator job. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Exported so `adb shell am broadcast` can reach it; absent from release builds. -->
        <receiver
            android:name=".debug.DebugReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver"
            xmlns:tools="http://schemas.android.com/tools">
            <intent-filter>
                <action android:name="dev.ferrux.debug.DUMP_SCREEN" />
                <action android:name="dev.ferrux.debug.SHOW_IME" />
                <action android:name="dev.ferrux.debug.TYPE" />
                <action android:name="dev.ferrux.debug.KEEP_SCREEN_ON" />
                <action android:name="dev.ferrux.debug.OPEN_DRAWER" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
